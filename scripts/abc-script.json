 {
  "label": "python3/stat/readlink",
  "tool": "exec",
  "args": {
   "command": "python3 -c 'print(1+1)' && stat -c '%s %F' /etc/hostname && readlink -f /proc/self/cwd && readlink -n /proc/self/cwd | wc -c && stat --version | head -1"
  }
 },
 {
  "label": "exec with env + PATH",
  "tool": "exec",
  "args": {
   "command": "echo \"FOO=$FOO\"; echo \"$PATH\" | cut -c1-90"
  }
 },
 {
  "label": "exec sees host-made file",
  "tool": "exec",
  "args": {
   "command": "cat abc/host-made.txt || echo MISSING"
  },
  "hostWrite": {
   "path": "@WORKSPACE@/abc/host-made.txt",
   "content": "made on host\n"
  }
 }
